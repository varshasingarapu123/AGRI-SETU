# GEMINI_API_KEY: Required for server-side Gemini AI agricultural assistant, Telugu STT, and Telugu TTS.
GEMINI_API_KEY=""

# Configurable AI model identifiers (defaults to Gemini 3.8 / 3.5 models on server)
AI_TEXT_MODEL="gemini-3.8-flash"
AI_STT_MODEL="gemini-3.5-transcribe"
AI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# APP_URL: Public URL of the hosted application
APP_URL=""

# Cloud SQL PostgreSQL runtime connection variables (injected automatically by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Cloud SQL PostgreSQL schema migration admin variables (used by Drizzle Kit)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
