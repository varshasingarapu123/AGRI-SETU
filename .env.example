# ============================================================================
# AGRISETU — Environment Configuration Template (.env.example)
# Copy this file to `.env` for local development. NEVER commit real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. REQUIRED — PostgreSQL / Cloud SQL Database Connection (Runtime)
# ----------------------------------------------------------------------------
SQL_HOST="127.0.0.1"
SQL_DB_NAME="agrisetu_db"
SQL_USER="agrisetu_app_user"
SQL_PASSWORD="replace_with_db_password"

# ----------------------------------------------------------------------------
# 2. REQUIRED FOR SCHEMA MIGRATIONS ONLY (drizzle-kit push)
# ----------------------------------------------------------------------------
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="replace_with_db_admin_password"

# ----------------------------------------------------------------------------
# 3. OPTIONAL — Gemini AI Configuration (Server-Side Only)
# When GEMINI_API_KEY is omitted, AGRISETU runs in a clearly labelled
# Demo RAG Mode using verified database records without fabricating live AI calls.
# ----------------------------------------------------------------------------
GEMINI_API_KEY="replace_with_gemini_api_key"
AI_TEXT_MODEL="gemini-3.8-flash"
AI_STT_MODEL="gemini-3.8-flash"
AI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# ----------------------------------------------------------------------------
# 4. OPTIONAL — Firebase Authentication & Role Governance
# Client config is loaded from firebase-applet-config.json when provisioned.
# Server-side token verification uses ADC or optional service account JSON.
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'

# Comma-separated verified Google emails authorized for the `coordinator` role
COORDINATOR_EMAILS="coordinator@example.org"

# ----------------------------------------------------------------------------
# 5. OPTIONAL — Controlled Demo Mode & Application Runtime
# Demo mode is automatically forced OFF whenever NODE_ENV="production".
# ----------------------------------------------------------------------------
ENABLE_DEMO_MODE="true"
DEMO_SESSION_SECRET="replace_with_at_least_32_random_characters"
APP_URL="http://localhost:3000"
